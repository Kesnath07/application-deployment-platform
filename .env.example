# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# PostgreSQL (docker-compose creates the database with these values)
DB_NAME=controlcenter
DB_USERNAME=controlcenter
DB_PASSWORD=change-me-local-only

# Background health probes of environment URLs (ISO-8601 durations, must be positive)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=PT60S
HEALTH_CHECK_TIMEOUT=PT3S

# Log level of the application's own packages
APP_LOG_LEVEL=INFO

# GitHub Actions workflow dispatch (optional).
# Use a fine-grained token limited to the target repositories with "Actions: Read and write".
GITHUB_DISPATCH_ENABLED=false
GITHUB_TOKEN=
